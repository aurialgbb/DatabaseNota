APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Runtime connection; all application SQL targets the dedicated nota_app schema.
DATABASE_URL=
# Local migration only: use a direct/session connection with schema creation rights.
# Keep this out of Vercel runtime when using a dedicated limited application role.
DATABASE_ADMIN_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=2
# Better Auth secret: generated once, keep only on the server and in local secrets.
BETTER_AUTH_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
GEMINI_API_KEY=
# Server-side Google Sheets access. Set one of these; share branch spreadsheets with its email.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional authenticated relay when the VPS cannot reach Google APIs directly.
SHEETS_RELAY_URL=
SHEETS_RELAY_SECRET=
# The VPS background worker processes approval, synchronization, and OCR jobs.
OCR_WORKER_ENABLED=true
OCR_REGION_BLOCKED=false
# Optional authenticated OCR relay; keep empty when Gemini works directly.
OCR_RELAY_URL=
OCR_RELAY_SECRET=
# Local deployment only; never expose to the browser.
CLOUDFLARE_API_TOKEN=
CRON_SECRET=
