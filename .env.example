APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Only set after creating a separate development PostgreSQL database.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=2
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
# JSON service-account credential; set in Vercel secrets, never commit a key file.
FIREBASE_ADMIN_CREDENTIALS=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CRON_SECRET=
# Comma-separated IDs of NEW spreadsheets; old targets must not be included.
ALLOWED_SPREADSHEET_IDS=
NATIVE_RELEASE_ENABLED=false
