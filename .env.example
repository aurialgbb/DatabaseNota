APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Runtime connection; all application SQL targets the dedicated nota_app schema.
DATABASE_URL=
# Local migration only: use a direct/session connection with schema creation rights.
# Keep this out of Vercel runtime when using a dedicated limited application role.
DATABASE_ADMIN_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=2
# Better Auth secret: generated once, keep only on the server and in local secrets.
BETTER_AUTH_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CRON_SECRET=
# Comma-separated IDs of NEW spreadsheets; old targets must not be included.
ALLOWED_SPREADSHEET_IDS=
NATIVE_RELEASE_ENABLED=false
