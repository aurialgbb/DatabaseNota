{
  "name": "database-nota-native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "baseline": "node scripts/capture-baseline.mjs",
    "build:ui": "node scripts/build-domain.mjs && node scripts/build-banner-art.mjs && node scripts/build-ui.mjs",
    "predev": "npm run build:ui",
    "dev": "next dev",
    "build": "npm run build:ui && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "node scripts/provision-database.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@vercel/functions": "^3.0.0",
    "firebase-admin": "^13.0.0",
    "next": "16.3.4",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "workflow": "4.8.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.0",
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
